<mxfile host="app.diagrams.net">
  <diagram name="Canal d'assistance" id="canal-assistance">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="citoyen" value="Citoyen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="drupal" value="Chatbot / Formulaire de contact&#10;(Portail Drupal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api" value="Service web — API Laravel&#10;POST /assistance-requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="270" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="db" value="Base de données partagée&#10;(table assistance_requests)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="410" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="email" value="Notification email&#10;(Mailtrap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="backoffice" value="Backoffice (Backpack)&#10;Gestion CRUD des demandes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="admin" value="Administrateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="565" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="(1) coordonnées (nom, téléphone)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="citoyen" target="drupal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="(2) POST /assistance-requests&#10;(authentification serveur)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="drupal" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="(3) enregistre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="(4) notifie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="api" target="email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="(5) reçoit l'alerte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="email" target="admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="lecture / mise à jour" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="db" target="backoffice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="(6) consulte &amp; traite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="admin" target="backoffice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
